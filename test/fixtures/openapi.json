{
  "openapi": "3.1.0",
  "info": {
    "title": "Widget API",
    "version": "1.0.0"
  },
  "paths": {
    "/widgets/{widgetId}": {
      "post": {
        "operationId": "postWidget",
        "parameters": [
          {
            "in": "path",
            "name": "widgetId",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "in": "query",
            "name": "dryRun",
            "schema": { "type": "boolean" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name"],
                "properties": {
                  "name": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["id"],
                  "properties": {
                    "id": { "type": "string" }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["detail"],
                  "properties": {
                    "detail": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
